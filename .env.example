# ---- Supabase (progress sync) ----
# Public values — safe to expose to the browser. Row Level Security guards the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# ---- AI Tutor ("Ask AI" button) ----
# SERVER-ONLY secrets. Set these in Vercel > Project > Settings > Environment Variables.
# NEVER commit the real key to git. Any OpenAI-compatible endpoint works.
AI_API_URL=https://openrouter.ai/api
AI_API_KEY=sk-or-v1-your-key-here
# default is a $0 model; set openai/gpt-4o for higher quality (paid per token)
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
