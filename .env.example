# ---- Supabase (progress sync) ----
# Public values — safe to expose to the browser. Row Level Security guards the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# ---- AI Tutor ("Ask AI" button) ----
# SERVER-ONLY secrets. Set these in Vercel > Project > Settings > Environment Variables.
# NEVER commit the real key to git.
AI_API_URL=https://api.bluesminds.com
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o-mini
